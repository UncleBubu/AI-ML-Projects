# --- Supabase (Project Settings > API) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY   # server only - never put this in the frontend

# --- Paystack (test keys). The same secret key signs webhooks. ---
PAYSTACK_SECRET_KEY=sk_test_xxx

# --- Optional ---
PORT=4000
FRONTEND_ORIGIN=http://localhost:5173
BUSINESS_TIMEZONE=Africa/Lagos
# Day 4 reminders (leave blank to just log + show a dashboard banner)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
REMINDER_INTERVAL_HOURS=24
REMINDER_CRON=0 8 * * *
DISABLE_SCHEDULER=false

# --- Customer reminders (optional). Without these, the "Remind customer" button explains what's missing. ---
# Email via any SMTP server. Gmail: smtp.gmail.com / 587 / your address / an APP PASSWORD (not your login password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
# SMS via Termii (termii.com). TERMII_BASE_URL is shown in your Termii dashboard's API docs.
TERMII_API_KEY=
TERMII_SENDER_ID=
TERMII_BASE_URL=https://api.ng.termii.com
CUSTOMER_REMINDER_COOLDOWN_HOURS=24

# --- AI (Day 7 Q&A + Day 8 insights): Meta Llama via LangChain ---
# Any OpenAI-compatible endpoint serving Llama works. Pick ONE preset:
#
# 1) Groq (free tier, fast) - key at console.groq.com/keys           <- default
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
#
# 2) Local Ollama (free, private, needs a decent PC) - `ollama pull llama3.1:8b`
#    LLM_BASE_URL=http://localhost:11434/v1
#    LLM_API_KEY=            (leave blank)
#    LLM_MODEL=llama3.1:8b
#
# 3) Together AI:   LLM_BASE_URL=https://api.together.xyz/v1   LLM_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
# 4) OpenRouter:    LLM_BASE_URL=https://openrouter.ai/api/v1  LLM_MODEL=meta-llama/llama-3.3-70b-instruct
AI_REQUESTS_PER_10MIN=20
